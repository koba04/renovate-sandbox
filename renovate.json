{
  "extends": [
    "github>kufu/renovate-config"
  ],
  "enabledManagers": [
    "npm"
  ],
  "npm": {
    "schedule": "at any time",
    "separateMinorPatch": true,
    "packageRules": [
      {
        "matchDepTypes": [
          "devDependencies"
        ],
        "matchUpdateTypes": [
          "patch"
        ],
        "automerge": true
      }
    ]
  }
}
